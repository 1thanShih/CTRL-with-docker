<launch>

    <!-- 雙相機切換 (false = 單相機；true = 雙相機) -->
    <arg name="dual_camera" default="false"/>

    <!-- 走線相機 -->
    <arg name="lane_cam_device" default="/dev/video0"/>
    <arg name="lane_cam_width"  default="640"/>
    <arg name="lane_cam_height" default="480"/>
    <arg name="lane_cam_fps"    default="30"/>

    <!-- 路標相機 (僅雙相機模式使用) -->
    <arg name="turn_cam_device" default="/dev/video1"/>
    <arg name="turn_cam_width"  default="640"/>
    <arg name="turn_cam_height" default="480"/>
    <arg name="turn_cam_fps"    default="30"/>

    <!-- =========================================================
         一次性把 config/lane_follower.yaml 載到全域 namespace。
         YAML 的頂層 key (lane_detect_node / turn_detect_node /
         lane_controller_fuzzy) 對應每個節點的私有 namespace，
         節點用 rospy.get_param('~xxx') 就讀得到。
         ========================================================= -->
    <rosparam command="load" file="$(find lane_follower)/config/lane_follower.yaml"/>

    <!-- rosserial_python 節點 -->
    <node pkg="rosserial_python" type="serial_node.py" name="arduino_mega_serial_node" output="screen">
        <param name="port" value="/dev/ttyUSB0"/>
        <param name="baud" value="115200"/>
    </node>

    <!-- 單相機：走線與路標共用 -->
    <group unless="$(arg dual_camera)">
        <node pkg="camera" type="camera.py" name="camera_node" output="screen">
            <param name="camera_id" value="$(arg lane_cam_device)"/>
            <param name="width"     value="$(arg lane_cam_width)"/>
            <param name="height"    value="$(arg lane_cam_height)"/>
            <param name="fps"       value="$(arg lane_cam_fps)"/>
        </node>
    </group>

    <!-- 雙相機：走線與路標各自一顆 -->
    <group if="$(arg dual_camera)">
        <node pkg="camera" type="camera.py" name="camera_node_lane" output="screen">
            <param name="camera_id" value="$(arg lane_cam_device)"/>
            <param name="width"     value="$(arg lane_cam_width)"/>
            <param name="height"    value="$(arg lane_cam_height)"/>
            <param name="fps"       value="$(arg lane_cam_fps)"/>
            <remap from="/camera/image_raw" to="/cam_lane/image_raw"/>
        </node>
        <node pkg="camera" type="camera.py" name="camera_node_turn" output="screen">
            <param name="camera_id" value="$(arg turn_cam_device)"/>
            <param name="width"     value="$(arg turn_cam_width)"/>
            <param name="height"    value="$(arg turn_cam_height)"/>
            <param name="fps"       value="$(arg turn_cam_fps)"/>
            <remap from="/camera/image_raw" to="/cam_turn/image_raw"/>
        </node>
    </group>

    <!-- 路標辨識節點 — 演算法參數從 yaml 載入，topic 仍依 dual_camera 動態決定 -->
    <node pkg="lane_follower" type="turn_detect.py" name="turn_detect_node" output="screen">
        <param name="image_topic" value="$(eval '/cam_turn/image_raw' if arg('dual_camera') else '/camera/image_raw')"/>
    </node>

    <!-- 車道辨識節點 -->
    <node pkg="lane_follower" type="lane_detect_v2.py" name="lane_detect_node" output="screen">
        <param name="image_topic" value="$(eval '/cam_lane/image_raw' if arg('dual_camera') else '/camera/image_raw')"/>
    </node>

    <!-- 模糊控制節點 -->
    <node pkg="lane_follower" type="lane_controller_fuzzy.py" name="lane_controller_fuzzy" output="screen"/>

</launch>
